# Optional Gemini planner / generated narrative features. Leave blank for local planning.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional MLflow tracking. Example local URI: file:./mlruns
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=AgenticDataLab

# Optional comma-separated tool names requiring human approval.
AGENTIC_APPROVAL_TOOLS=

# Persistent JSONL trace location. Defaults to project_storage/execution_traces.jsonl.
AGENTIC_TRACE_PATH=project_storage/execution_traces.jsonl
